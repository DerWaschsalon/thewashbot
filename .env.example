# Pflicht: Token aus dem Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=

# Empfohlen: ID eures Servers. Dann erscheinen neue Befehle sofort statt nach bis zu einer Stunde.
# (Rechtsklick auf den Servernamen → Server-ID kopieren; dafür in Discord den Entwicklermodus einschalten)
DEV_GUILD_ID=

# Optional: Spotify-Playlists über die offizielle API statt über die Einbettungsseite lesen
# (https://developer.spotify.com/dashboard → App anlegen)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Cookies-Datei, falls YouTube "Sign in to confirm you're not a bot" meldet
# (im Container-Pfad, z. B. /data/cookies.txt)
YTDLP_COOKIES=

# yt-dlp bei jedem Start aktualisieren (1/0)
YTDLP_AUTOUPDATE=1
# Höchstzahl Titel pro Playlist
MAX_PLAYLIST=100
LOG_LEVEL=INFO

# DeckBar-Gruppen-DPS-Webhook (siehe /setup dps-webhook): Port, auf dem der Bot auf DeckBar wartet
# (muss zu docker-compose.yml passen), und die LAN-IP dieses Servers für die angezeigte URL.
DPS_WEBHOOK_PORT=8787
DPS_WEBHOOK_HOST=

# Benachrichtigungen (🔔 im Einstellungen-Panel): GitHub erlaubt ohne Token nur 60 Anfragen/Stunde
# insgesamt, mit einem Token (nur Lesen nötig, github.com/settings/tokens) 5000/Stunde.
GITHUB_TOKEN=
# Wie oft nach neuen GitHub-Ereignissen geschaut wird (Minuten).
NOTIFY_POLL_MINUTES=10

# Web-Dashboard (Login mit Discord, nur für die per /setup dashboard festgelegte Rolle):
# Anwendungs-ID von der Seite "General Information" im Developer Portal …
DISCORD_CLIENT_ID=
# … und der "Geheimer Client-Schlüssel" von der Seite "OAuth2" dort (niemals teilen).
DISCORD_CLIENT_SECRET=
# Unter OAuth2 → Redirects muss genau http://<DASHBOARD_HOST>:<DASHBOARD_PORT>/callback eingetragen sein.
DASHBOARD_PORT=8788
DASHBOARD_HOST=
